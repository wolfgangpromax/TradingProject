{
  "ConnectionStrings": {
    "TradingAnalystDatabase": ""
  },
  "MarketData": {
    "Provider": "Binance",
    "Binance": {
      "BaseUrl": "https://data-api.binance.vision"
    },
    "Mexc": {
      "BaseUrl": "https://api.mexc.com"
    }
  },
  "TradingUniverse": {
    "Exchange": "BINANCE",
    "Symbols": [
      "BTCUSDT",
      "ETHUSDT",
      "SOLUSDT"
    ],
    "Timeframes": [
      1,
      5,
      15,
      60,
      240
    ],
    "RefreshIntervalSeconds": 60
  },
  "Trading": {
    "FairValueGapQualification": {
      "MinimumGapAtrRatio": 0.1
    }
  },
  "TradeSetup": {
    "StopLossAtrBufferMultiplier": 0.1,
    "MinimumRiskRewardRatio": 2.0
  },
  "RiskManagement": {
    "InitialAccountEquity": 10000.0,
    "RiskPerTradePercentage": 1.0,
    "MaximumDailyLossR": 3.0,
    "MaximumTradesPerDay": 5,
    "MaximumActiveTrades": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Scanner": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "CandleLimit": 500,
    "Symbols": [
      "BTCUSDT",
      "ETHUSDT",
      "SOLUSDT",
      "BNBUSDT",
      "XRPUSDT",
      "DOGEUSDT",
      "ADAUSDT",
      "AVAXUSDT",
      "LINKUSDT",
      "SUIUSDT"
    ]
  },
  "Notifications": {
    "Discord": {
      "WebhookUrl": ""
    }
  }
}